{
  "name": "smaltui",
  "version": "0.1.0",
  "description": "A static, in-browser query workbench for smaltdb databases",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/vendor-smaltdb.mjs && node scripts/vendor-smaltkit.mjs && node scripts/compile.mjs",
    "compile": "node scripts/compile.mjs",
    "typecheck": "tsc -p .",
    "dev": "node scripts/serve.mjs --watch",
    "vendor": "node scripts/vendor-smaltdb.mjs",
    "brand:sync": "node scripts/sync-brand.mjs",
    "build": "node scripts/build.mjs",
    "serve": "node scripts/compile.mjs && node scripts/serve.mjs",
    "preview": "node scripts/build.mjs .cache/preview/smaltui && node scripts/serve.mjs .cache/preview",
    "test": "node scripts/compile.mjs && node test/e2e.mjs",
    "deps": "node scripts/fetch-packed.mjs && node scripts/vendor-smaltdb.mjs && node scripts/compile.mjs",
    "docs:dev": "vitepress dev docs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "~7.0.2",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "smaltkit": "github:stenhoor/smaltkit#509b0a15a8916a646a2d56b518eaf4be93b1f0f9"
  }
}
